<mxfile host="local" modified="2026-10-23T00:00:00.000Z" agent="drawio" version="32.5.5">
  <diagram id="skill-workflow-architecture-page-1" name="skill-workflow-architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Portable skill/workflow decision flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="46" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Execute BASE, then let native Harness² propose, probe and compose/select, reflect the existing rollout, keep the oracle independent, then verify and publish with existing authority." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1600" height="28" as="geometry"/></mxCell>
        <mxCell id="band1" value="1  FRAME &amp;amp; FREEZE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1660" height="255" as="geometry"/></mxCell>
        <mxCell id="band2" value="2  NATIVE HARNESS² LOOP → INDEPENDENT DECISION  (flow right to left in this row)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1660" height="255" as="geometry"/></mxCell>
        <mxCell id="band3" value="3  VERIFY &amp; SHIP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1660" height="260" as="geometry"/></mxCell>
        <mxCell id="a1" value="1  User goal&lt;br&gt;non-trivial workflow or skill change" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#EAF2FF;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="a2" value="2  Workdoc&lt;br&gt;goal · scope · DoD · atomic checklist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#EAF2FF;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="a3" value="3  Scope &amp;amp; discovery&lt;br&gt;read policy, ADRs, coverage, current commands" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#EAF2FF;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="710" y="180" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="a4" value="4  Fixed base / model / inputs&lt;br&gt;revision · BASE · settings · model · budget · inputs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#4F8A5B;" vertex="1" parent="1"><mxGeometry x="1040" y="180" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="a5" value="5  External prerequisites&lt;br&gt;explicit CLI / runtime / credential checks; never inferred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#E8F5E9;strokeColor=#4F8A5B;" vertex="1" parent="1"><mxGeometry x="1370" y="180" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="b6" value="6  Baseline → Propose&lt;br&gt;BASE executes first (answer + receipt); then candidate edits, no oracle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#F3E8FF;strokeColor=#7E57A5;" vertex="1" parent="1"><mxGeometry x="1370" y="460" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="b7" value="7  Probe&lt;br&gt;same frozen inputs, settings, model and budget" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#F3E8FF;strokeColor=#7E57A5;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="b8" value="8  Compose / select&lt;br&gt;native harness picks from probe diffs; k=1 is not a separate model call" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#F3E8FF;strokeColor=#7E57A5;" vertex="1" parent="1"><mxGeometry x="710" y="460" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="b9" value="9  Reflect (post-selection)&lt;br&gt;native review of the existing rollout; candidate choice is not proof" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#F3E8FF;strokeColor=#7E57A5;" vertex="1" parent="1"><mxGeometry x="380" y="460" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="b10" value="10  Independent judge&lt;br&gt;oracle isolated from proposer / executor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#E6F7F1;strokeColor=#2E8B6E;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="c11" value="11  Adopt or KEEP_BASE&lt;br&gt;failure, timeout and tie are retained; no extra approval flow" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#E6F7F1;strokeColor=#2E8B6E;" vertex="1" parent="1"><mxGeometry x="50" y="740" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="c12" value="12  Command verification&lt;br&gt;uv --locked · just check · just test-contract; record rc / stdout / stderr" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1E6;strokeColor=#C46B2E;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="c13" value="13  Privacy review + authority&lt;br&gt;existing policy; a zero-hit scan is not a safety proof" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1E6;strokeColor=#C46B2E;" vertex="1" parent="1"><mxGeometry x="710" y="740" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="c14" value="14  Commit / push + source hash&lt;br&gt;publish only the generic, authorized surface" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1E6;strokeColor=#C46B2E;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="c15" value="15  Shared install + owned cleanup&lt;br&gt;portable artifacts only; no leftover renderer / agent process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1E6;strokeColor=#C46B2E;" vertex="1" parent="1"><mxGeometry x="1370" y="740" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="e-a1-a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a2-a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a3-a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a4-a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a5-b6" value="fixed run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b6-b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b7-b8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b8-b9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b9-b10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b10-c11" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c11-c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c12-c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c13-c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c14-c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="Oracle boundary: expected answers stay in the independent judge; never in the proposer, solver or executor context." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFF8E1;strokeColor=#C9A227;dashed=1;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="325" width="620" height="48" as="geometry"/></mxCell>
        <mxCell id="n2" value="Retain outcomes: failed, timed-out and tied candidates stay in the comparison table; never silently drop them." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFF8E1;strokeColor=#C9A227;dashed=1;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="325" width="630" height="48" as="geometry"/></mxCell>
        <mxCell id="n3" value="Static / synthetic checks stay separate from live external-runtime proof. just check needs no external CLI; just test-contract requires the pinned one and fails if absent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFF8E1;strokeColor=#C9A227;dashed=1;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="605" width="600" height="48" as="geometry"/></mxCell>
        <mxCell id="n4" value="21 shared skills = audit count at this revision, not a permanent constant. Canonical: policy · ADRs 0001/0002 · skill coverage · justfile." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFF8E1;strokeColor=#C9A227;dashed=1;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="605" width="670" height="48" as="geometry"/></mxCell>
        <mxCell id="footer" value="Read the decision record, not only the selected label: the judge is independent, the selected candidate is checked separately, and publication keeps existing authority." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1620" height="44" as="geometry"/></mxCell>
