        <mxCell id="m12" value="12. independent post-selection judgment + receipts (oracle isolated)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="anc-m12-s" target="anc-m12-t"><mxGeometry relative="1" as="geometry"/></mxCell>
