        <mxCell id="m10" value="10. compose / select harness from probe diffs; k=1 is a trivial selection, not a separate model call" style="edgeStyle=none;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="anc-m10-s" target="anc-m10-t"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note-outcomes" value="NOTE  [oracle boundary &amp; retained outcomes]  expected answers stay with the independent judge; never in the proposer or executor context. Failure, timeout and tie stay in the denominator. k=1 selection is not a separate model call and is not proof of quality gain." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7C8794;dashed=1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="28" y="585" width="1644" height="44" as="geometry"/></mxCell>
