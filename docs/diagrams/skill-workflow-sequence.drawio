        <mxCell id="m09" value="9. probe receipt; failure / timeout / tie retained" style="edgeStyle=none;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="anc-m09-s" target="anc-m09-t"><mxGeometry relative="1" as="geometry"/></mxCell>
